# ==============================================================================
# Smart Waste Management System - Environment Variables Template
# Copy this file to .env and configure values for local or production use.
# Do not commit .env to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Supabase PostgreSQL / Cloud or Local)
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=your_database_username
DB_PASSWORD=your_secure_database_password

# Full JDBC URL with SSL enabled (Required by Supabase)
DB_URL=jdbc:postgresql://your-supabase-host.pooler.supabase.com:5432/postgres?sslmode=require

# HikariCP Connection Pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# JPA / Hibernate
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# Flyway Database Migrations
# Set to true only when you are ready to apply database schema migrations
FLYWAY_ENABLED=false

# Thymeleaf Template Engine
THYMELEAF_CACHE=false
